{
	"name": "mw4-camo-grind",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:file": "vite build --mode file && node scripts/make-offline-file.js",
		"build:all": "npm run build:file && npm run build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"test": "node --test \"scripts/*.test.js\"",
		"test:file": "node scripts/test-offline-file.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "~4.0.1",
		"@sveltejs/kit": "~3.1.1",
		"@sveltejs/vite-plugin-svelte": "~7.3.1",
		"@tailwindcss/vite": "~4.3.4",
		"svelte": "~5.57.3",
		"svelte-check": "~4.7.8",
		"tailwindcss": "~4.3.4",
		"typescript": "~6.0.3",
		"vite": "~8.3.6"
	}
}
